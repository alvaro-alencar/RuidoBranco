<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="48dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moon_symbol"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/text_muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/status_stopped"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="240dp"
            android:layout_height="68dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/primary"
            android:elevation="4dp"
            android:text="@string/play"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:text="@string/volume_default"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseButton"
                android:layout_width="82dp"
                android:layout_height="62dp"
                android:backgroundTint="@color/secondary_button"
                android:contentDescription="@string/decrease_volume"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/increaseButton"
                android:layout_width="82dp"
                android:layout_height="62dp"
                android:backgroundTint="@color/secondary_button"
                android:contentDescription="@string/increase_volume"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/offline_message"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/safety_message"
            android:textColor="@color/text_subtle"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
