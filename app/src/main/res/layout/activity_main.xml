<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="42dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/ic_sleepy_moon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textColor="@color/text_muted"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/device_mode_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/playerRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:gravity="center_vertical"
                android:text="@string/player_mode"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/controllerRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:gravity="center_vertical"
                android:text="@string/controller_mode"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/connectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/remote_preparing"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pairButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/make_player_available"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/forgetButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:backgroundTint="@color/secondary_button"
                android:text="@string/forget"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/status_stopped"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="240dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:elevation="4dp"
            android:text="@string/play"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/volume_default"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseButton"
                android:layout_width="82dp"
                android:layout_height="62dp"
                android:backgroundTint="@color/secondary_button"
                android:contentDescription="@string/decrease_volume"
                android:text="−"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/increaseButton"
                android:layout_width="82dp"
                android:layout_height="62dp"
                android:backgroundTint="@color/secondary_button"
                android:contentDescription="@string/increase_volume"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/toneText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/tone_default"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/toneSeekBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/tone_control"
            android:max="200"
            android:progress="65"
            android:progressBackgroundTint="@color/secondary_button"
            android:progressTint="@color/primary"
            android:splitTrack="false"
            android:thumbTint="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tone_lower_label"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tone_center_label"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/tone_upper_label"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/offline_message"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/safety_message"
            android:textColor="@color/text_subtle"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
